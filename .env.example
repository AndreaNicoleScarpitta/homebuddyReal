# Local development only: copy to .env (never commit .env).
# Railway production/staging variables live in Railway, NOT this file.
# Docker Compose binds Postgres 16 only to localhost:5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/home_buddy
NODE_ENV=development
PORT=5000
# Generate locally using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
APP_URL=http://localhost:5000
OAUTH_BASE_URL=http://localhost:5000

# Optional Google OAuth — leave blank for normal local email/password sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional isolated development-only object storage — NEVER reuse homebuddy-prod.
# Only configure with a separate dev bucket and scoped token for upload tests.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Optional Stripe — test-mode credentials ONLY. Live key must stay in Railway.
# Legacy subscription synchronization stays disabled.
STRIPE_SYNC_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PREMIUM=

# Optional AI and email sandbox integrations.
AI_INTEGRATIONS_OPENAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# Optional frontend Google Places (public Vite variable).
VITE_GOOGLE_PLACES_API_KEY=

# Optional analytics / observability. Never use production service credentials locally.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
SENTRY_DSN=
